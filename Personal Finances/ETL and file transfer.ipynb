import os
import glob
import pandas as pd
import pyodbc
import tkinter as tk
from tkinter import ttk


# ============================================================
# CONFIGURATION
# ============================================================

SQL_SERVER = os.getenv("SQL_SERVER", "localhost")
SQL_DATABASE = os.getenv("SQL_DATABASE", "Finanse")
SQL_DRIVER = os.getenv("SQL_DRIVER", "ODBC Driver 17 for SQL Server")

ARCHIVE_FOLDER = os.path.join(
    os.path.expanduser("~"),
    "Finanse domowe",
    "Raporty"
)


# ============================================================
# STATUS WINDOW
# ============================================================

class StatusWindow:
    """
    Proste okno podglądowe pokazujące status trzech głównych etapów
    programu: wykrycie pliku, ETL danych i przeniesienie pliku.

    Każdy etap ma ikonę statusu:
    - oczekiwanie
    - sukces
    - błąd

    oraz linię z dodatkowym opisem.
    """

    ICONS = {
        "pending": ("⏳", "#888888"),
        "success": ("✔", "#2e7d32"),
        "error": ("✖", "#c62828"),
    }

    STAGE_LABELS = [
        "1. Wykrycie pliku w folderze Pobrane",
        "2. Przetworzenie danych (ETL)",
        "3. Przeniesienie pliku do folderu docelowego",
    ]

    def __init__(self):
        self.root = tk.Tk()
        self.root.title("Import historii transakcji")
        self.root.resizable(False, False)

        container = ttk.Frame(self.root, padding=16)
        container.grid(row=0, column=0, sticky="nsew")

        self.icon_labels = []
        self.detail_vars = []

        # Dynamiczne budowanie wierszy dla poszczególnych etapów
        for i, text in enumerate(self.STAGE_LABELS):

            icon_var = tk.StringVar(
                value=self.ICONS["pending"][0]
            )

            icon_label = tk.Label(
                container,
                textvariable=icon_var,
                font=("Segoe UI", 14),
                fg=self.ICONS["pending"][1],
                width=2,
            )

            icon_label.grid(
                row=i * 2,
                column=0,
                sticky="w",
                padx=(0, 8)
            )

            stage_label = ttk.Label(
                container,
                text=text,
                font=("Segoe UI", 10, "bold")
            )

            stage_label.grid(
                row=i * 2,
                column=1,
                sticky="w"
            )

            detail_var = tk.StringVar(
                value="Oczekiwanie..."
            )

            detail_label = ttk.Label(
                container,
                textvariable=detail_var,
                font=("Segoe UI", 9),
                foreground="#555555",
                wraplength=380,
                justify="left",
            )

            detail_label.grid(
                row=i * 2 + 1,
                column=1,
                sticky="w",
                pady=(0, 10)
            )

            self.icon_labels.append(
                (icon_label, icon_var)
            )

            self.detail_vars.append(
                detail_var
            )

        # Przycisk zamknięcia jest aktywowany dopiero po zakończeniu procesu
        self.close_button = ttk.Button(
            container,
            text="Zamknij",
            command=self.root.destroy,
            state="disabled"
        )

        self.close_button.grid(
            row=len(self.STAGE_LABELS) * 2,
            column=0,
            columnspan=2,
            pady=(8, 0)
        )

        # Natychmiastowe wyświetlenie okna
        self.root.update()

    def set_status(self, stage_index, status, detail=""):
        """
        Aktualizuje status wybranego etapu oraz odświeża okno.
        """

        icon_label, icon_var = self.icon_labels[stage_index]

        icon_char, color = self.ICONS[status]

        icon_var.set(icon_char)
        icon_label.configure(fg=color)

        if detail:
            self.detail_vars[stage_index].set(detail)

        self.root.update()

    def finish(self):
        """
        Odblokowuje przycisk zamknięcia i uruchamia pętlę zdarzeń GUI.
        """

        self.close_button.configure(
            state="normal"
        )

        self.root.mainloop()


# ============================================================
# FILE DISCOVERY
# ============================================================

def find_latest_report(downloads_path):
    """
    Szuka w folderze Downloads plików pasujących do wzorca:

        Historia_transakcji_*.csv

    i zwraca ścieżkę do najnowszego pliku.
    """

    pattern = os.path.join(
        downloads_path,
        "Historia_transakcji_*.csv"
    )

    files = glob.glob(pattern)

    if not files:
        return None

    return max(
        files,
        key=os.path.getctime
    )


# ============================================================
# DATA TRANSFORMATION
# ============================================================

def transform_columns(df):
    """
    Przekształca surowy DataFrame wczytany z CSV banku
    do formatu przeznaczonego do zapisania w bazie SQL.

    Operacje:
    - wybór wymaganych kolumn,
    - zmiana nazwy kolumny,
    - konwersja wartości liczbowych,
    - połączenie obciążeń i uznań w kolumnę Kwota.
    """

    required_columns = [
        "Data transakcji",
        "Opis",
        "Obciążenia",
        "Uznania",
    ]

    # Sprawdzenie wymaganych kolumn
    missing = [
        col
        for col in required_columns
        if col not in df.columns
    ]

    if missing:
        raise ValueError(
            f"Brakuje wymaganych kolumn w pliku CSV: {missing}"
        )

    # Pozostawienie wyłącznie potrzebnych kolumn
    df = df[required_columns].copy()

    # Zmiana nazwy kolumny
    df = df.rename(
        columns={
            "Data transakcji": "Data"
        }
    )

    def clean_numeric(column):
        """
        Czyści tekstową reprezentację liczb w polskim formacie.
        """

        return (
            column.astype(str)
            .str.replace(
                " ",
                "",
                regex=False
            )
            .str.replace(
                ",",
                ".",
                regex=False
            )
        )

    # Konwersja wartości liczbowych
    df["Obciążenia"] = pd.to_numeric(
        clean_numeric(df["Obciążenia"]),
        errors="coerce"
    )

    df["Uznania"] = pd.to_numeric(
        clean_numeric(df["Uznania"]),
        errors="coerce"
    )

    # Utworzenie jednej kolumny Kwota
    df["Kwota"] = (
        df["Uznania"].fillna(0)
        + df["Obciążenia"].fillna(0)
    )

    # Usunięcie kolumn pomocniczych
    df = df.drop(
        columns=[
            "Obciążenia",
            "Uznania"
        ]
    )

    return df


# ============================================================
# OUTPUT FILE NAME
# ============================================================

def build_output_filename(df):
    """
    Buduje nazwę pliku wyjściowego na podstawie
    miesiąca i roku pierwszej transakcji.
    """

    if df.empty:
        raise ValueError(
            "Plik nie zawiera żadnych transakcji."
        )

    first_date = pd.to_datetime(
        df["Data"].iloc[0]
    )

    return (
        f"Historia transakcji "
        f"{first_date.strftime('%m.%Y')}.csv"
    )


# ============================================================
# SQL UPLOAD
# ============================================================

def upload_to_sql(df, source_file):
    """
    Zapisuje przetworzone dane do tabeli Table_1
    w lokalnej bazie SQL Server.

    Następnie uruchamia procedurę AssignMerchants,
    która przypisuje merchantów do transakcji.
    """

    connection_string = (
        f"DRIVER={{{SQL_DRIVER}}};"
        f"SERVER={SQL_SERVER};"
        f"DATABASE={SQL_DATABASE};"
        "Trusted_Connection=yes;"
    )

    conn = None

    try:
        conn = pyodbc.connect(
            connection_string
        )

        cursor = conn.cursor()

        # Przyspieszenie executemany()
        cursor.fast_executemany = True

        # Przygotowanie danych do batch insert
        data = [
            (
                row.Data,
                row.Opis,
                row.Kwota,
                source_file
            )
            for row in df.itertuples(
                index=False
            )
        ]

        # Zapis danych do SQL Server
        cursor.executemany(
            """
            INSERT INTO Table_1
                (Data, Opis, Kwota, SourceFile)
            VALUES
                (?, ?, ?, ?)
            """,
            data
        )

        conn.commit()

        # Automatyczne przypisanie merchantów
        cursor.execute(
            "EXEC AssignMerchants"
        )

        conn.commit()

    except Exception:

        if conn is not None:
            conn.rollback()

        raise

    finally:

        if conn is not None:
            conn.close()


# ============================================================
# MAIN PROCESS
# ============================================================

def process_latest_report(
    downloads_path,
    target_folder,
    status_window
):
    """
    Główny proces aplikacji:

    1. Znajduje najnowszy raport CSV.
    2. Wczytuje i przekształca dane.
    3. Zapisuje dane do SQL Server.
    4. Archiwizuje przetworzony plik.
    """

    # --------------------------------------------------------
    # ETAP 1 — wykrycie pliku
    # --------------------------------------------------------

    latest_file = find_latest_report(
        downloads_path
    )

    if latest_file is None:

        status_window.set_status(
            0,
            "error",
            "Nie znaleziono pliku "
            "Historia_transakcji_*.csv"
        )

        return

    status_window.set_status(
        0,
        "success",
        f"Znaleziono plik: "
        f"{os.path.basename(latest_file)}"
    )

    # --------------------------------------------------------
    # ETAP 2 — ETL
    # --------------------------------------------------------

    try:

        df = pd.read_csv(
            latest_file,
            parse_dates=["Data transakcji"]
        )

        df = transform_columns(df)

        new_filename = build_output_filename(
            df
        )

        upload_to_sql(
            df,
            new_filename
        )

    except Exception as e:

        status_window.set_status(
            1,
            "error",
            f"Błąd ETL: {e}"
        )

        return

    status_window.set_status(
        1,
        "success",
        "Dane wczytane, oczyszczone "
        "i zapisane w SQL"
    )

    # --------------------------------------------------------
    # ETAP 3 — archiwizacja
    # --------------------------------------------------------

    try:

        os.makedirs(
            target_folder,
            exist_ok=True
        )

        target_file = os.path.join(
            target_folder,
            new_filename
        )

        # Jeżeli plik już istnieje,
        # zostanie zastąpiony nową wersją
        if os.path.exists(target_file):
            os.remove(target_file)

        df.to_csv(
            target_file,
            index=False
        )

        # Usunięcie źródłowego pliku
        os.remove(latest_file)

    except Exception as e:

        status_window.set_status(
            2,
            "error",
            f"Błąd przenoszenia pliku: {e}"
        )

        return

    status_window.set_status(
        2,
        "success",
        f"Nowa nazwa pliku: "
        f"{new_filename}"
    )


# ============================================================
# APPLICATION ENTRY POINT
# ============================================================

def main():

    status_window = StatusWindow()

    # Automatyczne wykrycie folderu Downloads
    downloads_path = os.path.join(
        os.path.expanduser("~"),
        "Downloads"
    )

    try:

        process_latest_report(
            downloads_path,
            ARCHIVE_FOLDER,
            status_window
        )

    finally:

        status_window.finish()


if __name__ == "__main__":
    main()
